# Copy this file to a new file named ".env" and fill in your real values.
# The .env file contains secrets and must NEVER be shared or pushed to GitHub.

# Get one at https://platform.openai.com/api-keys
# Replace the placeholder below with your OWN key. Never commit a real key.
OPENAI_API_KEY=your-api-key-here

# Flask's secret key, used for sessions (login, in a later step).
# Any long random string works.
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
SESSION_COOKIE_SECURE=0
CSRF_PROTECTION=1
LOG_LEVEL=INFO
